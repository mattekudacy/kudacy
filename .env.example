# Shared secret required in the `x-secret` header to use /api/chat, /api/publish, /api/upload
AGENT_PASSWORD=

# GitHub token used by /api/publish and /api/upload to commit posts/images via Octokit
GITHUB_TOKEN=

# --- Blog agent model (Ollama) ---
# Ollama exposes an OpenAI-compatible API, so the blog agent talks to it via @ai-sdk/openai
# pointed at a custom baseURL. Pick ONE of:
#
# 1) Self-hosted Ollama reachable from Vercel (e.g. tunneled or on a public host):
#      OLLAMA_BASE_URL=https://<your-ollama-host>/v1
#      OLLAMA_API_KEY=   (only needed if your server sits behind auth)
#
# 2) Ollama's hosted cloud models (https://ollama.com):
#      OLLAMA_BASE_URL=https://ollama.com/v1
#      OLLAMA_API_KEY=<your ollama.com API key>
OLLAMA_BASE_URL=https://ollama.com/v1
OLLAMA_API_KEY=

# Any model name available on your OLLAMA_BASE_URL, e.g. gpt-oss:120b, qwen3:32b, llama3.1:8b
OLLAMA_MODEL=gpt-oss:120b

# --- Blog agent tools ---
# Web search (Tavily) the agent can call mid-conversation to ground a post in real sources.
# Get a key at https://tavily.com. Optional — if unset, the searchWeb tool tells the agent
# search isn't configured yet instead of failing the whole request.
TAVILY_API_KEY=

# GITHUB_TOKEN (above) also powers the agent's searchGithubCode / readGithubFile tools,
# which default to reading mattekudacy/kudacy so the agent can pull real context from
# your own repo while drafting.
